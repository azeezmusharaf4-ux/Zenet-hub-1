rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if caller is the verified administrator/owner
    function isOwnerEmail() {
      return request.auth != null && (
        (request.auth.token.email is string && (
          request.auth.token.email.lower() == 'azeezmusharaf4@gmail.com' ||
          request.auth.token.email.lower() == 'muzenteofficial001@gmail.com' ||
          request.auth.token.email.lower() == 'azeezmusharaf@gmail.com' ||
          request.auth.token.email == 'zenet-backend-service@zenetmarketplace.internal' ||
          request.auth.token.email == 'system-backend@zenetmarketplace.app'
        )) ||
        request.auth.uid == 'LAn8Lec9ccT6rGEiDdylF8FfPZZ2' ||
        request.auth.uid == '6nTqAgRTFkYoIUmlZwUN52rRmwt2' ||
        request.auth.uid == 'SO3NblzYl2cQGoYtxuf58Wq1kOw1' ||
        request.auth.uid == '4Ro7kMiKr5bFZFHpMGT5OOzqv5N2'
      );
    }

    function isAdmin() {
      return request.auth != null && (
        isOwnerEmail() ||
        (request.auth.token.role is string && (request.auth.token.role == 'admin' || request.auth.token.role == 'owner')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        ))
      );
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin() || (
        isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referralCount', 'totalReferralEarnings', 'walletBalance', 'balance', 'updatedAt'])
      );
      allow delete: if isOwner(userId) || isAdmin();

      match /transactions/{txId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Wallets Collection (Dual persistence with users/{userId})
    match /wallets/{walletId} {
      allow read: if isAuthenticated() && (walletId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && (walletId == request.auth.uid || isAdmin());
    }

    // Account Deletion Requests (Strictly handled via server-side verification)
    match /account_deletion_requests/{requestId} {
      allow read, write: if isAdmin();
    }

    // Listings Collection (Public marketplace catalog)
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.sellerId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (
        resource.data.sellerId == request.auth.uid || 
        isAdmin() ||
        // Allow buyers to update stock and status during checkout
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'stockCount', 'status', 'inventory', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());

      // Inventory subcollection: status and availability of accounts (contains NO credentials/passwords)
      match /inventory/{itemId} {
        allow read: if true;
        allow create: if isAuthenticated() && (
          get(/databases/$(database)/documents/listings/$(listingId)).data.sellerId == request.auth.uid || 
          isAdmin()
        );
        allow update: if isAuthenticated() && (
          get(/databases/$(database)/documents/listings/$(listingId)).data.sellerId == request.auth.uid || 
          isAdmin() ||
          (request.resource.data.soldTo == request.auth.uid) ||
          (resource.data.soldTo == request.auth.uid)
        );
        allow delete: if isAuthenticated() && (
          get(/databases/$(database)/documents/listings/$(listingId)).data.sellerId == request.auth.uid || 
          isAdmin()
        );

        // Secure subcollection: credentials and backup codes for inventory accounts
        match /secure/{detailId} {
          allow read: if isAuthenticated() && (
            isAdmin() ||
            get(/databases/$(database)/documents/listings/$(listingId)).data.sellerId == request.auth.uid ||
            (
              exists(/databases/$(database)/documents/listings/$(listingId)/inventory/$(itemId)) &&
              get(/databases/$(database)/documents/listings/$(listingId)/inventory/$(itemId)).data.soldTo == request.auth.uid
            ) ||
            (resource.data != null && resource.data.soldTo == request.auth.uid)
          );
          allow write: if isAuthenticated() && (
            isAdmin() ||
            get(/databases/$(database)/documents/listings/$(listingId)).data.sellerId == request.auth.uid
          );
        }
      }
    }

    // Inquiries Collection (Private communications between buyer and seller)
    match /inquiries/{inquiryId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.buyerId == request.auth.uid || 
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Purchases Collection (Escrow and transaction records)
    match /purchases/{purchaseId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.buyerId == request.auth.uid || 
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Orders Collection (Log accounts and marketplace orders)
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.buyerEmail == request.auth.token.email ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Wallet Transactions
    match /wallet_transactions/{transactionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && (
        (request.resource.data.userId == request.auth.uid) || isAdmin()
      );
    }

    // Virtual Number Orders (Provider 1)
    match /virtual_number_orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && (
        (request.resource.data.userId == request.auth.uid) || isAdmin()
      );
    }

    // Virtual Number Orders (Provider 2)
    match /orders_service_number_2/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && (
        (request.resource.data.userId == request.auth.uid) || isAdmin()
      );
    }

    // Social Boost Orders (Provider 1)
    match /social_boost_orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && (
        (request.resource.data.userId == request.auth.uid) || isAdmin()
      );
    }

    // Social Boost Orders (Provider 2)
    match /orders_social_boost_2/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && (
        (request.resource.data.userId == request.auth.uid) || isAdmin()
      );
    }

    // ZENED U Update Products
    match /zenedUpdateProducts/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ZENED U Update Orders
    match /zenedUpdateOrders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.buyerId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && (request.resource.data.buyerId == request.auth.uid || isAdmin());
    }

    // Reports
    match /reports/{reportId} {
      allow read: if isAuthenticated() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.reporterId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.reviewerId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.reviewerId == request.auth.uid || isAdmin());
    }

    // Support Tickets
    match /tickets/{ticketId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Referrals
    match /referrals/{refId} {
      allow read: if isAuthenticated() && (
        resource.data.referrerId == request.auth.uid || 
        resource.data.referredUserId == request.auth.uid || 
        isAdmin()
      );
      allow write: if isAuthenticated() && (
        request.resource.data.referrerId == request.auth.uid || 
        isAdmin()
      );
    }

    // System Settings & Configuration (Social Boost pricing, catalogue, virtual numbers, platform rules)
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System Settings (Legacy and general settings)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Connection Health Check
    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Catch-all fallback for administrative maintenance
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}



