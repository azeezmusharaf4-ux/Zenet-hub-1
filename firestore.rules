rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if caller is the verified administrator/owner
    function isOwnerEmail() {
      return request.auth != null && (
        (request.auth.token.email is string && (
          request.auth.token.email.lower() == 'azeezmusharaf4@gmail.com' ||
          request.auth.token.email.lower() == 'muzenteofficial001@gmail.com' ||
          request.auth.token.email.lower() == 'azeezmusharaf@gmail.com' ||
          request.auth.token.email == 'zenet-backend-service@zenetmarketplace.internal' ||
          request.auth.token.email == 'system-backend@zenetmarketplace.app'
        )) ||
        request.auth.uid == 'LAn8Lec9ccT6rGEiDdylF8FfPZZ2' ||
        request.auth.uid == '6nTqAgRTFkYoIUmlZwUN52rRmwt2' ||
        request.auth.uid == 'SO3NblzYl2cQGoYtxuf58Wq1kOw1' ||
        request.auth.uid == '4Ro7kMiKr5bFZFHpMGT5OOzqv5N2'
      );
    }

    function isAdmin() {
      return request.auth != null && (
        isOwnerEmail() ||
        (request.auth.token.role is string && (request.auth.token.role == 'admin' || request.auth.token.role == 'owner')) ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        ))
      );
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Admins Collection (Fast lookup for administrative privileges)
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role in ['buyer', 'customer', 'seller'])) || isAdmin();
      allow update: if isAdmin() || (
        isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      ) || (
        isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referralCount', 'totalReferralEarnings', 'walletBalance', 'balance', 'withdrawalId', 'updatedAt', 'sellerTotalRevenue', 'sellerGrossSales', 'sellerOwnerFee', 'sellerCompletedSales'])
      );
      allow delete: if isOwner(userId) || isAdmin();

      match /transactions/{txId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Withdrawal Requests (Owner & Admin withdrawals)
    match /withdrawal_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Withdrawal Transaction IDs (Database-level uniqueness registry for withdrawal transactions)
    match /withdrawal_transaction_ids/{txId} {
      allow read, write: if isAdmin();
    }

    // Stock Approvals Collection (Audit trail for Owner stock approvals and rejections)
    match /stock_approvals/{approvalId} {
      allow read: if isAuthenticated() && (resource.data.submitterId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // User Notifications Collection (Permanent, read-only to other users, no deletion allowed)
    match /user_notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        (resource.data.userId == 'owner' && isAdmin()) || 
        isAdmin()
      );
      allow create: if isAuthenticated();
      // Allow marking as read only; deletion is strictly forbidden
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        (resource.data.userId == 'owner' && isAdmin()) || 
        isAdmin()
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'updatedAt']);
      allow delete: if false; // NOTIFICATIONS MUST NOT BE DELETED
    }

    // Seller Revenues Collection (Live 70% seller / 30% platform split tracking)
    match /seller_revenues/{sellerId} {
      allow read: if isAuthenticated() && (request.auth.uid == sellerId || isAdmin());
      allow write: if isAuthenticated();
    }

    // Wallets Collection (Dual persistence with users/{userId})
    match /wallets/{walletId} {
      allow read: if isAuthenticated() && (walletId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && (walletId == request.auth.uid || isAdmin());
    }

    // Account Deletion Requests (Strictly handled via server-side verification)
    match /account_deletion_requests/{requestId} {
      allow read, write: if isAdmin();
    }

    // Listings Collection (Public marketplace catalog - products remain permanently stored)
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.sellerId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (
        resource.data.sellerId == request.auth.uid || 
        isAdmin() ||
        // Allow buyers to update stock and status during checkout
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'stockCount', 'status', 'inventory', 'updatedAt'])
      );
      // Product deletion is strictly forbidden to protect marketplace history and records
      allow delete: if false;

      // Inventory subcollection: status and availability of accounts (contains NO credentials/passwords)
      match /inventory/{itemId} {
        allow read: if true;
        allow create: if isAuthenticated() && (
          get(/databases/$(database)/documents/listings/$(listingId)).data.sellerId == request.auth.uid || 
          isAdmin()
        );
        allow update: if isAuthenticated() && (
          get(/databases/$(database)/documents/listings/$(listingId)).data.sellerId == request.auth.uid || 
          isAdmin() ||
          (request.resource.data.soldTo == request.auth.uid) ||
          (resource.data.soldTo == request.auth.uid)
        );
        allow delete: if isAuthenticated() && (
          get(/databases/$(database)/documents/listings/$(listingId)).data.sellerId == request.auth.uid || 
          isAdmin()
        );

        // Secure subcollection: credentials and backup codes for inventory accounts
        match /secure/{detailId} {
          allow read: if isAuthenticated() && (
            isAdmin() ||
            get(/databases/$(database)/documents/listings/$(listingId)).data.sellerId == request.auth.uid ||
            (
              exists(/databases/$(database)/documents/listings/$(listingId)/inventory/$(itemId)) &&
              get(/databases/$(database)/documents/listings/$(listingId)/inventory/$(itemId)).data.soldTo == request.auth.uid
            ) ||
            (resource.data != null && resource.data.soldTo == request.auth.uid)
          );
          allow write: if isAuthenticated() && (
            isAdmin() ||
            get(/databases/$(database)/documents/listings/$(listingId)).data.sellerId == request.auth.uid
          );
        }
      }
    }

    // Inquiries Collection (Private communications between buyer and seller)
    match /inquiries/{inquiryId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.buyerId == request.auth.uid || 
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Purchases Collection (Escrow and transaction records)
    match /purchases/{purchaseId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.buyerId == request.auth.uid || 
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Orders Collection (Log accounts and marketplace orders)
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.buyerEmail == request.auth.token.email ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Wallet Transactions
    match /wallet_transactions/{transactionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && (
        (request.resource.data.userId == request.auth.uid) || isAdmin()
      );
    }

    // Virtual Number Orders (Provider 1)
    match /virtual_number_orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && (
        (request.resource.data.userId == request.auth.uid) || isAdmin()
      );
    }

    // Virtual Number Orders (Provider 2)
    match /orders_service_number_2/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && (
        (request.resource.data.userId == request.auth.uid) || isAdmin()
      );
    }

    // Social Boost Orders (Provider 1)
    match /social_boost_orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && (
        (request.resource.data.userId == request.auth.uid) || isAdmin()
      );
    }

    // Social Boost Orders (Provider 2)
    match /orders_social_boost_2/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && (
        (request.resource.data.userId == request.auth.uid) || isAdmin()
      );
    }

    // TikTok Promotion Services Configuration (Admin configurable, public read)
    match /tiktok_promotion_services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // TikTok Promotion Orders
    match /tiktok_promotion_orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ZENED U Update Products (Admins can view, create, and edit, but never delete)
    match /zenedUpdateProducts/{productId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ZENED U Update Orders
    match /zenedUpdateOrders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.buyerId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && (request.resource.data.buyerId == request.auth.uid || isAdmin());
    }

    // Reports
    match /reports/{reportId} {
      allow read: if isAuthenticated() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.reporterId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.reviewerId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.reviewerId == request.auth.uid || isAdmin());
    }

    // Support Tickets
    match /tickets/{ticketId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Referrals
    match /referrals/{refId} {
      allow read: if isAuthenticated() && (
        resource.data.referrerId == request.auth.uid || 
        resource.data.referredUserId == request.auth.uid || 
        isAdmin()
      );
      allow write: if isAuthenticated() && (
        request.resource.data.referrerId == request.auth.uid || 
        isAdmin()
      );
    }

    // System Settings & Configuration (Social Boost pricing, catalogue, virtual numbers, platform rules)
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System Settings (Legacy and general settings)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Connection Health Check
    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Catch-all fallback for administrative maintenance
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}



