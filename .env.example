# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Paystack Payment API Configurations
# The app works out-of-the-box in simulated demo mode or with real Paystack keys.
PAYSTACK_SECRET_KEY=
VITE_PAYSTACK_PUBLIC_KEY=

# OneGridHub Provider API configurations (Existing Provider)
ONEGRIDHUB_API_KEY=
ONEGRIDHUB_BASE_URL=https://onegridhub.com/api/v1/index.php
VIRTUAL_NUMBER_MARKUP=300
DIGITAL_PRODUCT_MARKUP=500

# PROVIDER 2: EstraLog Tools / XtraLogsTools Provider API Configurations (Virtual Numbers, SMM Boosting, Digital Products)
ESTRALOG_API_KEY=
ESTRALOG_BASE_URL=https://xtralogstools.com/api/v1/index.php
ESTRALOG_TOOLS_API_KEY=
ESTRALOG_TOOLS_BASE_URL=https://xtralogstools.com/api/v1/index.php
EXTRA_LOG_API_KEY=
EXTRA_LOG_BASE_URL=https://xtralogstools.com/api/v1/index.php
XTRALOGSTOOLS_API_KEY=
XTRALOGSTOOLS_BASE_URL=https://xtralogstools.com/api/v1/index.php
PROVIDER2_NUMBERS_API_KEY=
PROVIDER2_NUMBERS_BASE_URL=
PROVIDER2_SOCIAL_BOOST_API_KEY=
PROVIDER2_SOCIAL_BOOST_BASE_URL=

# Optional: Custom Backend API Base URL (if hosted on external static hosts like Netlify)
VITE_API_URL=

