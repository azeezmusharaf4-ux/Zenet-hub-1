# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Paystack Payment API Configurations
# The app works out-of-the-box in simulated demo mode or with real Paystack keys.
PAYSTACK_SECRET_KEY=
VITE_PAYSTACK_PUBLIC_KEY=

VIRTUAL_NUMBER_MARKUP=300
DIGITAL_PRODUCT_MARKUP=500

# VirtualSMSNumbers API Configuration
# Add your vsn_live_... API key from https://virtualsmsnumbers.com/dashboard/api-keys
VSN_API_KEY=
VSN_WEBHOOK_SECRET=
EUR_TO_NGN_RATE=1750

# Voiker Boosting Provider Configuration
# Obtain your API key from https://voiker.com/account/api or your Voiker account dashboard
# Configure this in Netlify under: Site configuration > Environment variables
VOIKER_API_KEY=
VOIKER_BASE_URL=https://voiker.com/api/v2
USD_TO_NGN_RATE=1650

# Optional: Custom Backend API Base URL (if hosted on external static hosts like Netlify)
VITE_API_URL=

