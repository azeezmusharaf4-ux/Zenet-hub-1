  "firestore": {
    "/seller_revenues/{sellerId}": {
      "schema": "seller_revenues",
      "description": "Live 70% seller earnings and 30% website owner commission split records"
    },
    "/users/{userId}": {
      "schema": "users",
      "description": "Registered user accounts and profiles"
    },
    "/listings/{listingId}": {
      "schema": "listings",
      "description": "Public social media account listings"
    },
    "/inquiries/{inquiryId}": {
      "schema": "inquiries",
      "description": "Buyer inquiries and communications"
    },
    "/purchases/{purchaseId}": {
      "schema": "purchases",
      "description": "Escrow orders and completed transactions"
    },
    "/wallet_transactions/{transactionId}": {
      "schema": "wallet_transactions",
      "description": "User deposits, deductions, and wallet records"
    },
    "/system_settings/{settingId}": {
      "schema": "social_boost_settings",
      "description": "System settings including Social Boost pricing markup, catalogues, and platform configuration"
    },
    "/settings/{settingId}": {
      "schema": "social_boost_settings",
      "description": "General application settings"
    },
    "/social_boost_orders/{orderId}": {
      "schema": "social_boost_orders",
      "description": "Growth boosting orders processed via OneGridHub"
    },
    "/virtual_number_orders/{orderId}": {
      "schema": "virtual_number_orders",
      "description": "Virtual phone number SMS orders"
    },
    "/tickets/{ticketId}": {
      "schema": "tickets",
      "description": "Support tickets"
    },
    "/referrals/{refId}": {
      "schema": "referrals",
      "description": "User referral reward records"
    },
    "/zenedUpdateProducts/{productId}": {
      "schema": "zenedUpdateProducts",
      "description": "Exclusive digital product inventory"
    },
    "/zenedUpdateOrders/{orderId}": {
      "schema": "zenedUpdateOrders",
      "description": "Purchased update orders"
    },
    "/wallets/{walletId}": {
      "schema": "users",
      "description": "User wallet balance mirror for dual persistence"
    },
    "/listings/{listingId}/inventory/{itemId}": {
      "schema": "listings",
      "description": "Individual account stock items for multi-stock listings"
    },
    "/listings/{listingId}/inventory/{itemId}/secure/{detailId}": {
      "schema": "listings",
      "description": "Sensitive credentials and backup codes for inventory accounts"
    }
  }
}
